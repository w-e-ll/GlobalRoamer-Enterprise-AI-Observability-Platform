APP_NAME=GlobalRoamer Enterprise AI Observability Platform
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=globalroamer
POSTGRES_USER=globalroamer
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://globalroamer:change_me@postgres:5432/globalroamer
ALEMBIC_DATABASE_URL=postgresql+psycopg://globalroamer:change_me@postgres:5432/globalroamer

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=globalroamer-platform
KAFKA_INTEGRATION_EVENTS_TOPIC=globalroamer.integration-events.v1
KAFKA_DEAD_LETTER_TOPIC=globalroamer.integration-events.dlq.v1
KAFKA_CONSUMER_GROUP_ID=globalroamer.pipeline-workers.v1
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_REQUEST_TIMEOUT_SECONDS=30
